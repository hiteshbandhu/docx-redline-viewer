{
  "name": "@yas.chat/docx-redline-viewer",
  "version": "0.1.0-beta.1",
  "description": "React component for rendering DOCX files with tracked changes (redlines) support — built for legal tech",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "format": "biome format --write src",
    "playground": "pnpm --filter playground dev",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hiteshbandhu/docx-redline-viewer"
  },
  "homepage": "https://github.com/hiteshbandhu/docx-redline-viewer#readme",
  "bugs": {
    "url": "https://github.com/hiteshbandhu/docx-redline-viewer/issues"
  },
  "keywords": ["docx", "word", "redline", "tracked-changes", "react", "legal-tech"]
}
